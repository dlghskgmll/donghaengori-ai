# 기본값은 mock입니다. mock | openai | auto 중 하나를 사용합니다.
AI_PROVIDER=mock

# 실제 키는 이 파일이나 코드에 넣지 말고 로컬 .env.local에만 설정합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=1
AI_FALLBACK_TO_MOCK=true

# 음성 → 텍스트 변환(STT) 모델. key는 위 OPENAI_API_KEY를 그대로 사용합니다.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 전화 webhook 서명 검증 secret (provider 확정 전 generic HMAC-SHA256).
# 비어 있으면 전화 webhook endpoint는 모든 요청을 거부합니다.
PHONE_WEBHOOK_SECRET=

# 전화 provider. 비우면 generic JSON webhook, clawops면 ClawOps adapter 사용.
PHONE_PROVIDER=
# 외부에 노출되는 앱 base URL (ClawOps 서명 검증·Record action 절대경로에 필요).
APP_BASE_URL=
# 설정 시 webhook의 AccountId가 일치하는지 추가 검증.
CLAWOPS_ACCOUNT_ID=
# 본선 데모 전용: 시연자 발신번호를 가상 환자 후보 조회에 매핑 (본인확인 아님).
DEMO_CALLER_PHONE=
DEMO_CALLER_PATIENT_ID=
