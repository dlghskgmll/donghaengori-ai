# 기본값은 mock입니다. mock | openai | auto | team 중 하나를 사용합니다.
# team = Team AI Backend(FastAPI) 사용. openai로 되돌리면 기존 경로로 rollback.
AI_PROVIDER=mock

# 실제 키는 이 파일이나 코드에 넣지 말고 로컬 .env.local에만 설정합니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=1
AI_FALLBACK_TO_MOCK=true

# 음성 → 텍스트 변환(STT) 모델. key는 위 OPENAI_API_KEY를 그대로 사용합니다.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 전화 webhook 서명 검증 secret (provider 확정 전 generic HMAC-SHA256).
# 비어 있으면 전화 webhook endpoint는 모든 요청을 거부합니다.
PHONE_WEBHOOK_SECRET=

# 전화 provider. 비우면 generic JSON webhook, clawops면 ClawOps adapter 사용.
PHONE_PROVIDER=
# 외부에 노출되는 앱 base URL (ClawOps 서명 검증·Record action 절대경로에 필요).
APP_BASE_URL=
# 설정 시 webhook의 AccountId가 일치하는지 추가 검증.
CLAWOPS_ACCOUNT_ID=
# 본선 데모 전용: 시연자 발신번호를 가상 환자 후보 조회에 매핑 (본인확인 아님).
DEMO_CALLER_PHONE=
DEMO_CALLER_PATIENT_ID=

# Team AI Backend (FastAPI) 연동 — AI_PROVIDER=team / STT_PROVIDER=team일 때 사용.
TEAM_AI_BASE_URL=http://localhost:8000
# local 모델 warmup 대비 timeout(ms). 데모 전 POST /api/warmup 호출 권장.
TEAM_AI_TIMEOUT_MS=30000
# STT provider: openai(기본) | team. team이면 Team backend /api/stt(faster-whisper) 사용.
STT_PROVIDER=

# ── Guardian(보호자 포털) 신청 저장소 ──
# 아직 durable provider가 없습니다. 기본값 memory는 개발 전용(프로세스 재시작 시 소멸)이며,
# production에서는 durable provider 없이 신청 API가 503으로 명시 거부됩니다(가짜 영속성 방지).
# durable provider(팀 backend/DB)가 준비되면 여기서 선택합니다.
GUARDIAN_PERSISTENCE=memory
# 개발/데모에서 production 빌드로 memory provider를 강제로 허용할 때만 1 (제품 사용 금지).
GUARDIAN_ALLOW_EPHEMERAL=
